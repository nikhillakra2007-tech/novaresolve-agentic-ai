# NovaResolve Configuration
PROJECT_NAME="NovaResolve"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# Default local PostgreSQL connection (PostgreSQL 18.x via psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/novacart

# API Configuration
API_V1_STR="/api"
PORT=8000
HOST="127.0.0.1"

# LLM Configuration (Phase 5)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
LLM_FALLBACK_TO_DETERMINISTIC=True
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
